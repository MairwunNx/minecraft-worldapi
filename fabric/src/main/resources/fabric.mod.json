{
  "schemaVersion": 1,
  "id": "worldapi",
  "version": "${version}",
  "name": "WorldAPI",
  "description": "A REST and WebSocket API for your world: players, statistics, events, and admin actions, with an admin panel. On a server, or in singleplayer for an AI agent through minecraft-mcp.",
  "authors": ["MairwunNx"],
  "contact": {
    "homepage": "https://modrinth.com/plugin/worldapi",
    "sources": "https://github.com/MairwunNx/minecraft-worldapi",
    "issues": "https://github.com/MairwunNx/minecraft-worldapi/issues"
  },
  "license": "MIT",
  "icon": "assets/worldapi/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.mairwunnx.worldapi.fabric.WorldApiMod"]
  },
  "mixins": ["worldapi.mixins.json"],
  "jars": [{ "file": "META-INF/jars/sqlite-jdbc-${sqlite}.jar" }],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "~${minecraft}",
    "java": ">=25"
  },
  "suggests": {
    "luckperms": "*"
  }
}
